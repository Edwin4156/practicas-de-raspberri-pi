# Práctica 6 - LCD 16x2 con Raspberry Pi Pico
# Modo paralelo de 4 bits
# Conexiones:
# LCD RS  -> GP0
# LCD E   -> GP1
# LCD D4  -> GP2
# LCD D5  -> GP3
# LCD D6  -> GP4
# LCD D7  -> GP5
# LCD RW  -> GND
# LCD VSS -> GND
# LCD VDD -> 3.3V
# LCD VO  -> Potenciómetro 10k
# LCD A   -> 3.3V con resistencia 220 ohm
# LCD K   -> GND

from machine import Pin
from time import sleep_ms


# Pines de control
RS = Pin(0, Pin.OUT)
E = Pin(1, Pin.OUT)

# Pines de datos en modo 4 bits
D4 = Pin(2, Pin.OUT)
D5 = Pin(3, Pin.OUT)
D6 = Pin(4, Pin.OUT)
D7 = Pin(5, Pin.OUT)

data_pins = [D4, D5, D6, D7]


def pulso_enable():
    E.value(0)
    sleep_ms(1)
    E.value(1)
    sleep_ms(1)
    E.value(0)
    sleep_ms(1)


def enviar_nibble(nibble):
    """
    Envía 4 bits al LCD.
    """
    for i in range(4):
        data_pins[i].value((nibble >> i) & 1)

    pulso_enable()


def enviar_byte(valor, modo):
    """
    modo = 0 para comando
    modo = 1 para dato/caracter
    """
    RS.value(modo)

    # Enviar parte alta
    enviar_nibble(valor >> 4)

    # Enviar parte baja
    enviar_nibble(valor & 0x0F)

    sleep_ms(2)


def comando(cmd):
    enviar_byte(cmd, 0)


def caracter(char):
    enviar_byte(ord(char), 1)


def escribir(texto):
    for letra in texto:
        caracter(letra)


def limpiar():
    comando(0x01)
    sleep_ms(2)


def posicionar(fila, columna):
    """
    fila 0 = primera línea
    fila 1 = segunda línea
    columna de 0 a 15
    """
    if fila == 0:
        direccion = 0x80 + columna
    else:
        direccion = 0xC0 + columna

    comando(direccion)


def iniciar_lcd():
    sleep_ms(50)

    RS.value(0)
    E.value(0)

    # Inicialización en modo 4 bits
    enviar_nibble(0x03)
    sleep_ms(5)

    enviar_nibble(0x03)
    sleep_ms(5)

    enviar_nibble(0x03)
    sleep_ms(5)

    enviar_nibble(0x02)
    sleep_ms(5)

    # Configuración del LCD
    comando(0x28)  # 4 bits, 2 líneas, matriz 5x8
    comando(0x0C)  # Display encendido, cursor apagado
    comando(0x06)  # Incremento automático del cursor
    limpiar()


# Programa principal
iniciar_lcd()

posicionar(0, 0)
escribir("Raspberry Pico")

posicionar(1, 0)
escribir("LCD 16x2 OK")

while True:
    sleep_ms(1000)